{
	"name": "lendtrial",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:server": "VITE_LENDTRIAL_SERVER=1 vite dev",
		"build": "vite build",
		"build:server": "VITE_LENDTRIAL_SERVER=1 vite build",
		"start": "node build-server/index.js",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:workspace": "playwright test --config playwright.workspace.config.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
